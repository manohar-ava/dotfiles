# --- General ---
*.swp
*.swo
*.tmp
*~
*.log
.DS_Store

# --- ZSH ---
zsh/.zsh_history
zsh/.zsh_sessions
zsh/.zcompdump*
zsh/.cache/

# Plugin managers / frameworks (don’t commit external code)
zsh/.oh-my-zsh/
zsh/.antigen/
zsh/.zinit/

# --- TMUX ---
# TPM plugins (inside your tmux folder)
tmux/.config/tmux/plugins/

# tmux runtime / session data
tmux/tmux_resurrect/
tmuxinator/*.lock
*.tmux.swp
tmux/.tmux.conf.local

# --- Shell environment ---
.env
.envrc

# Language/version managers (if ever inside repo)
.nodenv/
.pyenv/
.rbenv/
